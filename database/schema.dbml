// Database Markup Language (DBML) for dbdiagram.io
// Project: Restaurant Management System (E-Menu & POS)
// Target Database: MySQL / Laravel 10

Project restaurant_management_system {
  database_type: 'MySQL'
  Note: '''
    # Restaurant Management System Database Schema
    Enterprise E-Menu, Multilingual Product Catalog, Variations, Inventory, POS, Orders, and Marketing.
  '''
}

// ----------------------------------------------------
// ENUMS
// ----------------------------------------------------

Enum general_status {
  active
  inactive
}

Enum product_status {
  available
  unavailable
}

Enum reservation_status {
  pending
  confirmed
  cancelled
  completed
}

Enum order_type {
  dine_in   [note: '1. Dine-in: Scan QR code on table and order']
  takeaway  [note: '2. Takeaway: Customer orders and takes food away']
  delivery  [note: '3. Delivery: Customer orders for home delivery']
}

Enum order_status {
  pending
  preparing
  served
  completed
  cancelled
}

Enum payment_method {
  cash
  credit_card
  debit_card
  qr
  online
}

Enum payment_status {
  pending
  completed
  failed
  refunded
}

Enum review_status {
  pending
  approved
  hidden
}

Enum prize_type {
  free_product
  discount_percentage
  discount_fixed
  coupon
  try_again
}

// ----------------------------------------------------
// 1. BUSINESSES / RESTAURANTS & BRANCHES
// ----------------------------------------------------

Table businesses {
  id bigint [pk, increment]
  name varchar(255) [not null]
  description text [null]
  phone varchar(50) [null]
  email varchar(255) [null]
  address text [null]
  logo varchar(255) [null]
  status general_status [default: 'active']
  created_at timestamp [null]
  updated_at timestamp [null]

  Note: 'Core restaurant business entity'
}

Table branches {
  id bigint [pk, increment]
  business_id bigint [not null]
  name varchar(255) [not null]
  phone varchar(50) [null]
  email varchar(255) [null]
  address text [not null]
  city varchar(100) [null]
  opening_time time [null]
  closing_time time [null]
  status general_status [default: 'active']
  created_at timestamp [null]
  updated_at timestamp [null]

  Note: 'Restaurant physical branch locations'
}

// ----------------------------------------------------
// 2. SOCIALS & BUSINESS SOCIAL LINKS
// ----------------------------------------------------

Table socials {
  id bigint [pk, increment]
  name varchar(100) [not null]
  image varchar(255) [null]
  created_at datetime [null]
  updated_at datetime [null]

  Note: 'Social platforms: Facebook, Telegram, TikTok, Instagram'
}

Table business_social_links {
  id bigint [pk, increment]
  business_id bigint [not null]
  social_id bigint [not null]
  value varchar(255) [not null]
  created_at datetime [null]
  updated_at datetime [null]

  indexes {
    (business_id, social_id) [unique]
  }

  Note: 'Social media profile handles & URLs per business'
}

// ----------------------------------------------------
// 3. MULTILINGUAL & LOCALIZATION
// ----------------------------------------------------

Table languages {
  id bigint [pk, increment]
  name varchar(100) [not null]
  code varchar(10) [unique, not null, note: 'e.g. en, km, zh']
  created_at datetime [null]
  updated_at datetime [null]

  Note: 'Supported system languages'
}

// ----------------------------------------------------
// 4. CATEGORIES & CATEGORY LANGUAGES
// ----------------------------------------------------

Table categories {
  id bigint [pk, increment]
  parent_id bigint [null]
  name varchar(150) [not null]
  image varchar(255) [null]
  slug varchar(255) [null]
  created_at datetime [null]
  updated_at datetime [null]

  Note: 'Hierarchical product categories with sub-categories'
}

Table category_languages {
  id bigint [pk, increment]
  category_id bigint [not null]
  language_id bigint [not null]
  name varchar(150) [not null]
  created_at datetime [null]
  updated_at datetime [null]

  indexes {
    (category_id, language_id) [unique]
  }

  Note: 'Translations of category names'
}

// ----------------------------------------------------
// 5. PROMOTIONS
// ----------------------------------------------------

Table promotions {
  id bigint [pk, increment]
  name varchar(150) [not null]
  discount_type int [default: 1, note: '1: Percentage, 2: Fixed amount']
  discount_value decimal(12,2) [not null]
  start_date datetime [not null]
  end_date datetime [not null]
  is_active boolean [default: true]
  created_at timestamp [null]
  updated_at timestamp [null]

  Note: 'Promotions, campaign discounts, and promotional rules'
}

// ----------------------------------------------------
// 6. UNIT TYPES, PRODUCTS, OPTIONS & VARIATIONS
// ----------------------------------------------------

Table unit_types {
  id bigint [pk, increment]
  name varchar(100) [not null, note: 'Cup, Glass, Plate, Bowl, Can, Bottle, Portion']

  Note: 'Standard measurement and serving unit types'
}

Table products {
  id bigint [pk, increment]
  name varchar(255) [not null]
  sku varchar(100) [null]
  code varchar(100) [null]
  price decimal(12,3) [not null, default: 0]
  tag varchar(100) [null]
  manage_stock boolean [default: false]
  allow_stock_negative boolean [default: false]
  category_id bigint [not null]
  image varchar(255) [null]
  promotion_id bigint [null]
  created_at datetime [null]
  updated_at datetime [null]

  Note: 'Products and menu items with inventory controls'
}

Table product_images {
  id bigint [pk, increment]
  product_id bigint [not null]
  image varchar(255) [not null]
  sort_order int [default: 0]
  created_at datetime [null]

  Note: 'Product photo gallery'
}

Table product_languages {
  id bigint [pk, increment]
  product_id bigint [not null]
  language_id bigint [not null]
  name varchar(255) [not null]
  description text [null]

  Note: 'Multilingual product name and description translations'
}

Table product_variations {
  id bigint [pk, increment]
  product_id bigint [not null]
  name varchar(255) [not null]
  product_unit_id bigint [null]
  unit_type_id bigint [null]
  is_multiplier boolean [default: false]
  variant_group varchar(100) [null, note: 'e.g. Size, Ice, Sugar Level']
  price decimal(12,3) [not null]
  image varchar(255) [null]
  tag varchar(100) [null]
  promotion_id bigint [null]

  Note: 'Product variants with distinct pricing, units, and tags'
}

Table product_variation_languages {
  id bigint [pk, increment]
  product_variation_id bigint [not null]
  language_id bigint [not null]
  name varchar(255) [not null]

  Note: 'Multilingual translations for product variation names'
}

Table product_options {
  id bigint [pk, increment]
  product_id bigint [not null]
  name varchar(150) [not null, note: 'e.g. Extra Cheese, Less Ice, No Spicy']
  created_at datetime [null]

  Note: 'Add-on modifier options per product'
}

// ----------------------------------------------------
// 7. MENUS & MENU ITEMS
// ----------------------------------------------------

Table menus {
  id bigint [pk, increment]
  business_id bigint [not null]
  name varchar(255) [not null]
  description text [null]
  start_time time [null]
  end_time time [null]
  status general_status [default: 'active']
  created_at timestamp [null]
  updated_at timestamp [null]

  Note: 'Special menus (Breakfast, Lunch, Dinner, Happy Hour)'
}

Table menu_items {
  id bigint [pk, increment]
  menu_id bigint [not null]
  product_id bigint [not null]
  custom_price decimal(12,3) [null]
  is_available boolean [default: true]
  created_at timestamp [null]
  updated_at timestamp [null]

  Note: 'Pivot linking products into specific menus with custom pricing'
}

// ----------------------------------------------------
// 8. RESERVATIONS
// ----------------------------------------------------

Table reservations {
  id bigint [pk, increment]
  branch_id bigint [not null]
  table_number varchar(50) [null, note: 'Reserved table number or area preference']
  customer_name varchar(255) [not null]
  customer_phone varchar(50) [not null]
  customer_email varchar(255) [null]
  guest_count int [default: 1]
  reservation_date date [not null]
  reservation_time time [not null]
  status reservation_status [default: 'pending']
  special_requests text [null]
  created_at timestamp [null]
  updated_at timestamp [null]

  Note: 'Table booking and reservations'
}

Table dining_tables {
  id bigint [pk, increment]
  branch_id bigint [null]
  table_number varchar(50) [not null]
  capacity int [default: 4]
  status varchar(50) [default: 'available', note: 'available, occupied, reserved, maintenance']
  created_at timestamp [null]
  updated_at timestamp [null]

  Note: 'Restaurant dining tables'
}

Table table_sessions {
  id bigint [pk, increment]
  dining_table_id bigint [not null]
  session_token varchar(255) [unique, not null, note: 'Unique session token for table QR scanning and guest stay']
  status varchar(50) [default: 'active', note: 'active, closed, completed, cancelled']
  opened_at datetime [null]
  closed_at datetime [null]
  created_at timestamp [null]
  updated_at timestamp [null]

  Note: 'Active dining sessions opened per table'
}

// ----------------------------------------------------
// 9. ORDERS & ORDER ITEMS (3 E-Menu Order Types)
// ----------------------------------------------------

Table orders {
  id bigint [pk, increment]
  branch_id bigint [not null]
  table_session_id bigint [null, note: 'Associated table session for dine-in']
  order_number varchar(255) [unique, not null]
  order_type order_type [default: 'dine_in', note: '1. dine_in, 2. takeaway, 3. delivery']
  table_number varchar(50) [null, note: 'For Dine-in: table number from QR scan or customer input']
  customer_name varchar(255) [null, note: 'For Takeaway & Delivery']
  customer_phone varchar(50) [null, note: 'For Takeaway & Delivery']
  delivery_address text [null, note: 'For Delivery order only']
  delivery_fee decimal(12,3) [default: 0, note: 'Delivery fee for delivery orders']
  total decimal(12,3) [default: 0]
  total_amount decimal(12,3) [default: 0]
  discount_amount decimal(12,3) [default: 0]
  final_amount decimal(12,3) [default: 0]
  status order_status [default: 'pending']
  notes text [null]
  created_at timestamp [null]
  updated_at timestamp [null]

  Note: 'Customer orders: 1. Dine-in (QR Code on table), 2. Takeaway, 3. Delivery'
}

Table order_items {
  id bigint [pk, increment]
  order_id bigint [not null]
  product_id bigint [not null]
  product_variation_id bigint [null, note: 'Selected variation']
  quantity int [default: 1]
  unit_price decimal(12,3) [not null]
  subtotal decimal(12,3) [not null]
  special_instructions text [null]
  created_at timestamp [null]
  updated_at timestamp [null]

  Note: 'Line items within an order'
}

// ----------------------------------------------------
// 10. PAYMENTS & RECEIPTS
// ----------------------------------------------------

Table payments {
  id bigint [pk, increment]
  order_id bigint [not null]
  payment_method payment_method [default: 'cash']
  amount decimal(12,3) [not null]
  transaction_id varchar(255) [null]
  status payment_status [default: 'pending']
  paid_at timestamp [null]
  created_at timestamp [null]
  updated_at timestamp [null]

  Note: 'Payment records and transactions per order'
}

Table receipts {
  id bigint [pk, increment]
  order_id bigint [unique, not null]
  receipt_number varchar(100) [unique, not null]
  total decimal(12,3) [not null]
  issued_at timestamp [default: `now()`]
  created_at timestamp [null]
  updated_at timestamp [null]

  Note: 'Final official receipts issued per completed order'
}

// ----------------------------------------------------
// 11. REVIEWS & ROAD MAPS & PROFILES
// ----------------------------------------------------

Table reviews {
  id bigint [pk, increment]
  business_id bigint [null]
  product_id bigint [null]
  customer_name varchar(255) [null]
  rating tinyint [default: 5, note: '1 to 5 stars']
  comment text [null]
  status review_status [default: 'approved']
  created_at timestamp [null]
  updated_at timestamp [null]

  Note: 'Customer reviews and ratings'
}

Table road_maps {
  id bigint [pk, increment]
  image text [not null]
  title varchar(255) [not null]
  description text [not null]
  created_at timestamp [null]
  updated_at timestamp [null]

  Note: 'Project and restaurant road maps'
}

Table profiles {
  id bigint [pk, increment]
  image varchar(255) [null]
  created_at timestamp [null]
  updated_at timestamp [null]

  Note: 'User or general profile photo storage'
}

// ----------------------------------------------------
// 12. FOOD LUCKY WHEEL
// ----------------------------------------------------

Table lucky_wheel_prizes {
  id bigint [pk, increment]
  business_id bigint [null]
  title varchar(150) [not null, note: 'e.g. Free Drink, 10% Off, $2 Coupon']
  description text [null]
  prize_type prize_type [default: 'free_product']
  discount_value decimal(12,2) [null]
  product_id bigint [null, note: 'Referenced free item (Drink/Food)']
  coupon_code varchar(50) [null]
  probability int [default: 10, note: 'Winning probability weight']
  slice_color varchar(30) [default: '#2563EB', note: 'Wheel slice color hex']
  text_color varchar(30) [default: '#FFFFFF']
  icon varchar(255) [null]
  quantity int [null, note: 'Total available stock']
  remaining_quantity int [null]
  is_active boolean [default: true]
  created_at timestamp [null]
  updated_at timestamp [null]

  Note: 'Food Lucky Wheel prizes and wheel slice configurations'
}

Table lucky_wheel_spins {
  id bigint [pk, increment]
  user_id bigint [null]
  customer_name varchar(255) [null]
  customer_phone varchar(50) [null]
  business_id bigint [null]
  branch_id bigint [null]
  prize_id bigint [not null]
  redeem_code varchar(50) [unique, not null, note: 'e.g. SPIN-XXXXXX']
  is_redeemed boolean [default: false]
  redeemed_at timestamp [null]
  expires_at timestamp [null]
  notes text [null]
  created_at timestamp [null]
  updated_at timestamp [null]

  Note: 'Spin records and reward redemption tracking'
}

// ----------------------------------------------------
// 13. USERS & SOCIAL ACCOUNTS
// ----------------------------------------------------

Table users {
  id bigint [pk, increment]
  name varchar(255) [not null]
  email varchar(255) [unique, not null]
  password varchar(255) [not null]
  role_id int [default: 1]
  email_verified_at timestamp [null]
  remember_token varchar(100) [null]
  created_at timestamp [null]
  updated_at timestamp [null]

  Note: 'System users and administrators'
}

Table linked_google_accounts {
  id bigint [pk, increment]
  user_id bigint [not null]
  provider_name varchar(50) [default: 'google']
  provider_id varchar(255) [not null]
  created_at timestamp [null]
  updated_at timestamp [null]

  Note: 'OAuth linked social accounts for Google login'
}

// ----------------------------------------------------
// RELATIONSHIPS / FOREIGN KEYS
// ----------------------------------------------------

Ref: branches.business_id > businesses.id [delete: cascade]

Ref: business_social_links.business_id > businesses.id [delete: cascade]
Ref: business_social_links.social_id > socials.id [delete: cascade]

Ref: categories.parent_id > categories.id [delete: set null]
Ref: category_languages.category_id > categories.id [delete: cascade]
Ref: category_languages.language_id > languages.id [delete: cascade]

Ref: products.category_id > categories.id [delete: cascade]
Ref: products.promotion_id > promotions.id [delete: set null]

Ref: product_images.product_id > products.id [delete: cascade]

Ref: product_languages.product_id > products.id [delete: cascade]
Ref: product_languages.language_id > languages.id [delete: cascade]

Ref: product_variations.product_id > products.id [delete: cascade]
Ref: product_variations.unit_type_id > unit_types.id [delete: set null]
Ref: product_variations.promotion_id > promotions.id [delete: set null]

Ref: product_variation_languages.product_variation_id > product_variations.id [delete: cascade]
Ref: product_variation_languages.language_id > languages.id [delete: cascade]

Ref: product_options.product_id > products.id [delete: cascade]

Ref: menus.business_id > businesses.id [delete: cascade]
Ref: menu_items.menu_id > menus.id [delete: cascade]
Ref: menu_items.product_id > products.id [delete: cascade]

Ref: reservations.branch_id > branches.id [delete: cascade]

Ref: dining_tables.branch_id > branches.id [delete: cascade]
Ref: table_sessions.dining_table_id > dining_tables.id [delete: cascade]
Ref: orders.table_session_id > table_sessions.id [delete: set null]

Ref: orders.branch_id > branches.id [delete: cascade]
Ref: order_items.order_id > orders.id [delete: cascade]
Ref: order_items.product_id > products.id [delete: cascade]
Ref: order_items.product_variation_id > product_variations.id [delete: set null]

Ref: payments.order_id > orders.id [delete: cascade]
Ref: receipts.order_id - orders.id [delete: cascade]

Ref: reviews.business_id > businesses.id [delete: cascade]
Ref: reviews.product_id > products.id [delete: cascade]

Ref: lucky_wheel_prizes.business_id > businesses.id [delete: cascade]
Ref: lucky_wheel_prizes.product_id > products.id [delete: set null]

Ref: lucky_wheel_spins.user_id > users.id [delete: set null]
Ref: lucky_wheel_spins.business_id > businesses.id [delete: cascade]
Ref: lucky_wheel_spins.branch_id > branches.id [delete: cascade]
Ref: lucky_wheel_spins.prize_id > lucky_wheel_prizes.id [delete: cascade]

Ref: linked_google_accounts.user_id > users.id [delete: cascade]

// ----------------------------------------------------
// VISUAL TABLE GROUPS FOR DBDIAGRAM.IO
// ----------------------------------------------------

TableGroup organization {
  businesses
  branches
  socials
  business_social_links
  users
  linked_google_accounts
  profiles
}

TableGroup catalog_and_multilingual {
  categories
  category_languages
  languages
  unit_types
  products
  product_images
  product_languages
  product_options
  product_variations
  product_variation_languages
  menus
  menu_items
}

TableGroup orders_and_pos {
  dining_tables
  table_sessions
  reservations
  orders
  order_items
  payments
  receipts
}

TableGroup marketing_and_promotions {
  promotions
  reviews
  road_maps
  lucky_wheel_prizes
  lucky_wheel_spins
}
